GOOGLE_API_KEY=your_key_goes_here
OPENROUTER_API_KEY=your_openrouter_key_goes_here
OPENROUTER_VISION_MODEL=nex-agi/nex-n2.5-mini:free
# OpenRouter STT — no :free Whisper models exist; use an active transcription slug
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
# Future direct OpenAI Whisper
# OPENAI_API_KEY=your_openai_key_goes_here
# OPENAI_STT_MODEL=whisper-1
# Optional free local Whisper (OpenAI-compatible server, e.g. faster-whisper)
# LOCAL_STT_URL=http://127.0.0.1:8080
# LOCAL_STT_MODEL=whisper-base
# LOCAL_STT_API_KEY=
# Local rembg (BiRefNet) — best open-source cutouts
# Host: http://127.0.0.1:7000  |  Docker Compose: http://rembg:7000
REMBG_URL=http://127.0.0.1:7000
REMBG_MODEL=birefnet-general
FAL_KEY=your_fal_key_goes_here
EDEN_AI_API_KEY=your_eden_ai_key_goes_here
EDEN_AI_PROVIDERS=openai
EDEN_AI_BG_PROVIDERS=api4ai
EDEN_AI_MODEL=openai/gpt-image-1.5
EDEN_AI_RESOLUTION=1024x1024
EDEN_AI_VISION_MODEL=openai/gpt-4o-mini
FLUXAPI_API_KEY=your_fluxapi_key_goes_here
FLUXAPI_MODEL=flux-kontext-pro
PORT=8787
